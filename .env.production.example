# Copy to .env.production (ignored by Git). Do not use the demo database/credentials.
# Launch only after configuring the server/DNS:
# docker compose --env-file .env.production -f compose.production.yml up -d --build

# Hostname only, without https://, port or path. Its A/AAAA DNS records must point
# to the server; inbound TCP 80/443 must be reachable for HTTPS certificates.
APP_DOMAIN=
ACME_EMAIL=

# Generate a unique hexadecimal password: openssl rand -hex 32
# Hex avoids reserved characters when Compose builds DATABASE_URL.
POSTGRES_PASSWORD=

# Optional Discord login: configure both, or leave both empty.
# Redirect URI: https://<APP_DOMAIN>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional Twitch integration: configure both, or leave both empty.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=

# Optional password-reset emails. SMTP_FROM is required when SMTP_HOST is set.
# Use a sender approved by your email provider, for example Redak <contact@your-domain>.
# Port 587 uses STARTTLS; port 465 generally requires SMTP_SECURE=true.
# SMTP_REQUIRE_TLS=true prevents sending credentials/emails over plaintext SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional alert receiver accepting JSON {type,text,checkedAt} over HTTPS.
# Empty means checks are logged locally without external notifications.
MONITOR_WEBHOOK_URL=
# Defaults to https://<APP_DOMAIN>/api/health.
MONITOR_URL=
